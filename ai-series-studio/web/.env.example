# Copy to .env.local (git-ignored). Never commit real keys.
DATABASE_URL=postgres://localhost/microdrama_studio
# Needed to read new sources. Without it, only recorded results in fixtures/llm replay.
ANTHROPIC_API_KEY=
# Set to 1 to save live model results as fixtures for tests.
RECORD_FIXTURES=0
# Where uploaded and generated files are stored (defaults to .data/storage).
STORAGE_ROOT=
# Step 2 image generation. OpenAI is used when OPENAI_API_KEY is set; otherwise Gemini.
# IMAGE_PROVIDER=openai|gemini|mock forces one (mock = placeholder images, no cost).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
OPENAI_IMAGE_QUALITY=medium
OPENAI_EST_CENTS_PER_IMAGE=8
GEMINI_API_KEY=
IMAGE_PROVIDER=
PROJECT_IMAGE_BUDGET_USD=25
WORKER_CONCURRENCY=4
# Step 3 voices (ElevenLabs). VOICE_PROVIDER=mock gives labelled test tones instead.
ELEVENLABS_API_KEY=
ELEVENLABS_DESIGN_MODEL=eleven_ttv_v3
ELEVENLABS_TTS_MODEL=eleven_v4
VOICE_PROVIDER=

# Video: Higgsfield REST API key from the Higgsfield API console (see docs.higgsfield.ai), written as KEY_ID:KEY_SECRET. Prepaid USD, separate from website credits.
# Without it, step 4 makes free placeholder clips so the flow can be tested.
HIGGSFIELD_API_KEY=
PROJECT_VIDEO_BUDGET_USD=40
