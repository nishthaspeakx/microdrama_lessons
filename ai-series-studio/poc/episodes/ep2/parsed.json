        {
          "id": "e2_l03",
          "kind": "dialogue",
          "who": "devendra",
          "text": "सुबह लोग पूछेंगे, ये बच्चा कहाँ से आया।",
          "delivery": "low, at the sink, out of the boy's hearing"
        },
        {
          "id": "e2_l04",
          "kind": "dialogue",
          "who": "suman",
          "text": "हम कहेंगे, हमें खेत में मिला।",
          "delivery": "quiet"
        },
        {
          "id": "e2_l05",
          "kind": "dialogue",
          "who": "devendra",
          "text": "और जो खेत में उसके पीछे था?",
          "delivery": "low"
        },
        {
          "id": "e2_l06",
          "kind": "action",
          "who": null,
          "text": "Suman looks back. The boy has quietly put a piece of गुड़ beside her plate too."
        },
        {
          "id": "e2_l07",
          "kind": "dialogue",
          "who": "suman",
          "text": "आज से ये हमारा बेटा है, देवेंद्र।",
          "delivery": "dry, decided; Suman stays on screen for the whole line",
          "decisive": true
        },
        {
          "id": "e2_l08",
          "kind": "action",
          "who": null,
          "text": "Devendra takes that in. He goes back to the table, tears a roti in half and gives the boy the bigger piece.",
          "music_cue": "Home enters here"
        },
        {
          "id": "e2_l09",
          "kind": "dialogue",
          "who": "devendra",
          "text": "वीर नाम कैसा रहेगा?"
        },
        {
          "id": "e2_l10",
          "kind": "action",
          "who": null,
          "text": "Suman tries the name out loud. The boy looks up when she says it."
        },
        {
          "id": "e2_l11",
          "kind": "dialogue",
          "who": "suman",
          "text": "वीर।"
